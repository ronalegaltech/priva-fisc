    let t78 = circuit_mul(t77, in2);
    let t79 = circuit_mul(in9, t78);
    let t80 = circuit_mul(t66, t78);
    let t81 = circuit_mul(t68, t78);
    let t82 = circuit_mul(t80, in6);
    let t83 = circuit_sub(in8, in0);
    let t84 = circuit_sub(in5, in6);
    let t85 = circuit_mul(in4, t79);
    let t86 = circuit_sub(t84, t85);
    let t87 = circuit_mul(t83, t86);
    let t88 = circuit_add(t82, t87);
    let t89 = circuit_sub(in6, in3);
    let t90 = circuit_mul(t81, t89);
    let t91 = circuit_add(t88, t90);
    let t92 = circuit_mul(t77, in7);
    let t93 = circuit_sub(t91, t92);

    let modulus = modulus;

    let mut circuit_inputs = (t77, t93).new_inputs();
    // Prefill constants:
    circuit_inputs = circuit_inputs
        .next_2(
            [0x8712848a692c553d0329f5d6, 0x64751ad938e2b5e6a54cf8c6, 0x204bd3277422fad3, 0x0],
        ); // in0
    circuit_inputs = circuit_inputs.next_2([0x1, 0x0, 0x0, 0x0]); // in1
    circuit_inputs = circuit_inputs
        .next_2(
            [0x313fb720b29e139e5c100001, 0x8e97f570caffd704cb0bb460, 0x3033ea246e506e89, 0x0],
        ); // in2
    // Fill inputs:
    circuit_inputs = circuit_inputs.next_2(p_libra_evaluation);

    for val in p_libra_poly_evals {
        circuit_inputs = circuit_inputs.next_u256(*val);
    }
    circuit_inputs = circuit_inputs.next_2(tp_gemini_r);

    circuit_inputs = circuit_inputs.next_2(challenge_poly_eval);

    circuit_inputs = circuit_inputs.next_2(root_power_times_tp_gemini_r);

    let outputs = circuit_inputs.done_2().eval(modulus).unwrap();
    let vanishing_check: u384 = outputs.get_output(t77);
    let diff_check: u384 = outputs.get_output(t93);
    return (vanishing_check, diff_check);
}

