# Pinned toolchain for the Noir circuits and the Starknet verifier (pinned 2026-11-12).
# Source this file before running nargo / bb / scarb / snforge or the tests in tools/efi:
#     . tools/toolchain.env
# The versions match what Garaga (commit d97b4d3269fe) generates verifiers for. They are installed
# side by side under ~/.pf-toolchain and do not replace any globally installed version.
#
#   nargo   1.0.0   (noirc 275d3ab1a5c9)
#   bb      6.0.0   proofs: `bb prove -t evm` (keccak transcript, zero-knowledge flavour)
#   scarb   2.21.0  (cairo 2.21.0)
#   snforge 0.64.1  (+ universal-sierra-compiler, see below)
#   starknet-devnet 0.10.1  (local network for tools/starknet/devnet_demo.sh)
#   garaga  main @ d97b4d3269fe   (built from source; run it as "$PF_GARAGA", its Python
#                                  environment is deliberately NOT put on PATH)
export PF_TOOLCHAIN="${PF_TOOLCHAIN:-$HOME/.pf-toolchain}"
export PATH="$PF_TOOLCHAIN/nargo/bin:$PF_TOOLCHAIN/bb:$PF_TOOLCHAIN/scarb/bin:$PF_TOOLCHAIN/snfoundry/bin:$PF_TOOLCHAIN/usc/bin:$PATH"
# Rust is only needed to build snforge's Scarb plugin and Garaga itself.
export RUSTUP_HOME="$PF_TOOLCHAIN/rustup" CARGO_HOME="$PF_TOOLCHAIN/cargo"
export PATH="$PF_TOOLCHAIN/cargo/bin:$PATH"
export UNIVERSAL_SIERRA_COMPILER="$PF_TOOLCHAIN/usc/bin/universal-sierra-compiler"
export PF_GARAGA="$PF_TOOLCHAIN/garaga-venv/bin/garaga"
